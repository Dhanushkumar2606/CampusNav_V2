# Copy to .env and fill in before running the backend.

# 1) DATABASE_URL
#    Local SQLite (default — works without Docker; geo columns are nullable):
DATABASE_URL=sqlite:///./campusnav.db

#    Postgres + PostGIS (recommended for Phase 2 spatial queries; switch here
#    once Docker Desktop is running and you've brought up the postgis container):
# DATABASE_URL=postgresql+psycopg://campusnav:campusnav@localhost:5433/campusnav

# 2) JWT_SECRET — REQUIRED in production. Generate a real secret, e.g.
#    `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
#    The default below is intentionally a placeholder: never deploy with it.
JWT_SECRET=change-me-please-this-is-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# 3) App metadata
#    production rejects nothing at boot, but must be set to `production` so
#    the /api/root payload and any env-gated behavior report correctly.
APP_ENV=development
APP_VERSION=0.1.0

# 4) CORS — parseable origins (comma-separated). Production must contain the
#    deployed frontend origin(s), e.g.:
#    CORS_ORIGINS=https://campusnav-v2-<user>.vercel.app
# Dev defaults (Vite dev server):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
