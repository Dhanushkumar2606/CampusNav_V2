# Copy to .env and fill in before running the backend.

# 1) DATABASE_URL
#    Local SQLite (default — works without Docker; geo columns are nullable):
DATABASE_URL=sqlite:///./campusnav.db

#    Postgres + PostGIS (recommended for Phase 2 spatial queries; switch here
#    once Docker Desktop is running and you've brought up the postgis container):
# DATABASE_URL=postgresql+psycopg://campusnav:campusnav@localhost:5433/campusnav

# 2) JWT_SECRET — REPLACE before any non-local run. The default below is
#    intentionally placeholder; the app will boot, but the secret is rejected
#    if APP_ENV=production.
JWT_SECRET=change-me-please-this-is-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# 3) App metadata
APP_ENV=development
APP_VERSION=0.1.0

# 4) CORS — for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 5) Premium feature flag
PREMIUM=false