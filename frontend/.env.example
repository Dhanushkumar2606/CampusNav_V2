# Frontend build-time environment (copy to .env for local overrides — never commit).

# Production (split deployment): absolute backend origin, e.g.
# VITE_API_URL=https://campusnav-api.onrender.com
#
# When UNSET (default), the app uses same-origin relative /api/... paths:
#   - local dev: Vite proxy forwards /api -> http://localhost:8000
#   - single-host deployment: FastAPI serves the SPA + API from one origin
VITE_API_URL=

# Premium feature build flag (matches the backend PREMIUM env):
# PREMIUM=true

# DEV-ONLY: deterministic simulated GPS. Never set in production builds.
# VITE_SIMULATED_GPS=true